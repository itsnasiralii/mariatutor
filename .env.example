# Maria Tutor Marketplace — Environment Variables Reference
FLASK_APP=app.py
FLASK_ENV=production
SECRET_KEY=generate_a_random_secure_hex_key_here
IDENTIFIER_PEPPER=generate_a_random_secure_pepper_key_here
COOKIE_SECURE=1

# Database Connection (Postgres on Render, or defaults to local SQLite)
# DATABASE_URL=postgresql+psycopg://user:password@host/dbname

# Super Admin Initial Credentials (Default: admin@mariahome.com / Admin123)
BOOTSTRAP_SUPERADMIN_EMAIL=admin@mariahome.com
BOOTSTRAP_SUPERADMIN_PASSWORD=Admin123
